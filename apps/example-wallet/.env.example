# All optional. Defaults target Solana devnet + the Ika pre-alpha + public testnets.

# Solana RPC (devnet). The public endpoint is rate limited; use your own for smoother polling.
VITE_SOLANA_RPC=https://api.devnet.solana.com
# ika_account program (Ika Portal policy program) on devnet.
VITE_PROGRAM_ID=Dx7P74pmeMqgPG4iF3VpL5aZ6TZTMiPzcMULnpu2hyje
# Ika pre-alpha dWallet program + gRPC-web endpoint.
VITE_IKA_DWALLET_PROGRAM_ID=87W54kGYFQ1rgWqMeu4XTPHWXWmXSQCcjm8vCTfiq1oY
VITE_IKA_GRPC_URL=https://pre-alpha-dev-1.ika.ika-network.net

# Relayer for delegated (EIP-7702, gasless) EVM mode and dWallet-signed recovery cancel.
# Without it, EVM sends use direct mode (the dWallet EOA pays gas).
VITE_RELAYER_URL=

# Testnet backends.
VITE_ESPLORA_URL=https://mempool.space/testnet4/api
VITE_BTC_EXPLORER=https://mempool.space/testnet4
VITE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Swaps. NEAR Intents is only added when a 1Click proxy URL is set (mainnet dry quotes only).
VITE_NEAR_PROXY_URL=
# Demo swap provider deposit addresses. Default: the account's own addresses (no funds leave the account).
VITE_MOCK_DEPOSIT_BTC=
VITE_MOCK_DEPOSIT_EVM=
# Integrator fee recipient (EVM address) and bps.
VITE_INTEGRATOR_FEE_RECIPIENT=0x000000000000000000000000000000000000dEaD
VITE_INTEGRATOR_FEE_BPS=30
