{
  "name": "ika-portal",
  "description": "Ika Portal: native Bitcoin, Ethereum and Base accounts for every Solana account, controlled by Solana via Ika dWallets.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build:programs": "anchor build && ./scripts/sync-idl.sh",
    "test:programs": "cargo test -p ika_account",
    "test:contracts": "cd contracts/evm && forge test",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:parity": "E2E_SUITES=solana vitest run --config vitest.e2e.config.ts tests/e2e/parity.test.ts",
    "test:all": "pnpm test:programs && pnpm test:contracts && pnpm test && pnpm test:e2e",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "stack:up": "docker compose -f docker/compose.yaml up -d --build --wait",
    "stack:down": "docker compose -f docker/compose.yaml down -v",
    "test:e2e:docker": "E2E_EXTERNAL=1 E2E_RELAYER_URL=http://127.0.0.1:8787 vitest run --config vitest.e2e.config.ts",
    "test:hybrid": "tsx scripts/hybrid-e2e.ts"
  },
  "devDependencies": {
    "@ika-portal/chains": "workspace:*",
    "@ika-portal/core": "workspace:*",
    "@ika-portal/relayer": "workspace:*",
    "@ika-portal/signer": "workspace:*",
    "@ika-portal/swap": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "^2.1.4",
    "@types/node": "^24.0.0",
    "bitcoinjs-lib": "^7.0.2",
    "bn.js": "^5.2.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "viem": "^2.57.1",
    "vitepress": "1.6.4",
    "vitest": "^5.0.0"
  },
  "license": "BSD-3-Clause-Clear"
}
